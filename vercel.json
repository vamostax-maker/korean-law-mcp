{
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --omit=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
